# Anthropic API key — server-side only, never exposed to the client.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres connection (compose-internal host `db` when running under docker compose).
DATABASE_URL=postgresql://postgres:postgres@db:5432/electrical_poc?schema=public

# Where uploaded submission files are stored (mounted volume in docker compose).
UPLOAD_DIR=/data/uploads

# Model used for extraction + compliance analysis.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Name shown as the reviewing engineer on generated letters.
REVIEWING_ENGINEER=Alex Sam, P.Eng.
